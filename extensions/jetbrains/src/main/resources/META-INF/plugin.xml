<idea-plugin>
  <id>com.rustcode.jetbrains</id>
  <name>RustCode</name>
  <vendor email="rustcode@rustcode.dev">RustCode</vendor>

  <!-- Localized action text/description (%action.* keys in messages.RustCodeBundle) -->
  <resource-bundle>messages.RustCodeBundle</resource-bundle>

  <description><![CDATA[
    RustCode brings a local AI coding agent into JetBrains IDEs.

    Use RustCode from a dedicated tool window, editor context actions, and intentions to explain, fix, optimize, and review code while keeping the IDE workflow native. The plugin connects to a local RustCode daemon on 127.0.0.1 by default and supports user-configured providers such as OpenAI, Claude, and Ollama through that daemon.

    Code, selected text, attached files, project metadata, provider settings, and API keys are sent only when needed to fulfill user actions and are handled by the local RustCode daemon. See the privacy policy for details before configuring external model providers.
  ]]></description>

  <change-notes><![CDATA[
    Initial JetBrains Marketplace release.
    <ul>
      <li>Added the RustCode tool window for local AI coding workflows.</li>
      <li>Added editor actions and intentions for explaining, fixing, optimizing, and attaching code context.</li>
      <li>Added local daemon discovery, startup, health checks, and bundled daemon support.</li>
      <li>Added session history, provider setup, model selection, diagnostics, and privacy-oriented context controls.</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="rustcode-jcef.xml">com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow
      id="RustCode"
      anchor="right"
      canCloseContents="true"
      factoryClass="com.rustcode.jetbrains.ui.RustCodeToolWindowFactory"
      icon="/icons/rustcode.svg" />

    <applicationConfigurable
      id="rustcode.settings"
      displayName="RustCode"
      instance="com.rustcode.jetbrains.settings.RustCodeConfigurable" />

    <statusBarWidgetFactory
      id="RustCodeStatus"
      implementation="com.rustcode.jetbrains.ui.RustCodeStatusBarWidgetFactory" />

    <intentionAction>
      <className>com.rustcode.jetbrains.actions.ExplainSelectionIntention</className>
      <category>RustCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.rustcode.jetbrains.actions.FixSelectionIntention</className>
      <category>RustCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.rustcode.jetbrains.actions.OptimizeSelectionIntention</className>
      <category>RustCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.rustcode.jetbrains.actions.AddContextIntention</className>
      <category>RustCode</category>
    </intentionAction>

    <projectService serviceImplementation="com.rustcode.jetbrains.services.RustCodeProjectService" />
    <projectService serviceImplementation="com.rustcode.jetbrains.session.SessionWorkspace" />
    <projectService serviceImplementation="com.rustcode.jetbrains.persistence.RustCodeProjectWorkspaceState" />
    <applicationService serviceImplementation="com.rustcode.jetbrains.settings.RustCodeSettingsState" />
    <applicationService serviceImplementation="com.rustcode.jetbrains.services.RustCodeDaemonSupervisor" />
    <postStartupActivity implementation="com.rustcode.jetbrains.services.RustCodeStartupActivity" />
  </extensions>

  <actions>
    <action
      id="rustcode.openChat"
      class="com.rustcode.jetbrains.actions.OpenChatAction"
      text="%action.openChat.text"
      description="%action.openChat.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.openWelcome"
      class="com.rustcode.jetbrains.actions.OpenWelcomeAction"
      text="%action.openWelcome.text"
      description="%action.openWelcome.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.openChatInNewTab"
      class="com.rustcode.jetbrains.actions.OpenChatInNewTabAction"
      text="%action.openChatInNewTab.text"
      description="%action.openChatInNewTab.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.focusInput"
      class="com.rustcode.jetbrains.actions.FocusInputAction"
      text="%action.focusInput.text"
      description="%action.focusInput.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift I" />
    </action>

    <action
      id="rustcode.newConversation"
      class="com.rustcode.jetbrains.actions.NewConversationAction"
      text="%action.newConversation.text"
      description="%action.newConversation.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift N" />
    </action>

    <action
      id="rustcode.stopGeneration"
      class="com.rustcode.jetbrains.actions.StopGenerationAction"
      text="%action.stopGeneration.text"
      description="%action.stopGeneration.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.openChanges"
      class="com.rustcode.jetbrains.actions.OpenChangesAction"
      text="%action.openChanges.text"
      description="%action.openChanges.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.openSettings"
      class="com.rustcode.jetbrains.actions.OpenSettingsAction"
      text="%action.openSettings.text"
      description="%action.openSettings.desc">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="rustcode.explainSelection"
      class="com.rustcode.jetbrains.actions.ExplainSelectionAction"
      text="%action.explainSelection.text"
      description="%action.explainSelection.desc">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift E" />
    </action>

    <action
      id="rustcode.fixSelection"
      class="com.rustcode.jetbrains.actions.FixSelectionAction"
      text="%action.fixSelection.text"
      description="%action.fixSelection.desc">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action
      id="rustcode.optimizeSelection"
      class="com.rustcode.jetbrains.actions.OptimizeSelectionAction"
      text="%action.optimizeSelection.text"
      description="%action.optimizeSelection.desc">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action
      id="rustcode.addContext"
      class="com.rustcode.jetbrains.actions.AddContextAction"
      text="%action.addContext.text"
      description="%action.addContext.desc">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
