FROM debian:bookworm-slim

# Optional regional APT mirror for faster downloads, passed as a build arg, e.g.
#   docker build --build-arg APT_MIRROR=http://mirrors.aliyun.com ...
# Leave unset to use the upstream Debian mirrors (the neutral default).
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null || true; \
    fi

# Install required utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/bash rustcode

WORKDIR /home/rustcode

# Copy pre-built Linux binaries from dist directory
COPY dist/v*/rustcode-daemon-*-linux-x64 /tmp/rustcode-daemon

# Install binaries
RUN chmod +x /tmp/rustcode-daemon && \
    mv /tmp/rustcode-daemon /usr/local/bin/rustcode-daemon

# Expose daemon port
EXPOSE 13456

WORKDIR /workspace

# Start daemon only
ENTRYPOINT ["rustcode-daemon"]
