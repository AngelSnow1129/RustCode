FROM debian:bookworm-slim

# Optional regional APT mirror for faster downloads, passed as a build arg, e.g.
#   docker build --build-arg APT_MIRROR=http://mirrors.aliyun.com ...
# Leave unset to use the upstream Debian mirrors (the neutral default).
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
        sed -i "s|http://deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list 2>/dev/null || true; \
    fi

# Install required utilities
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/bash rustcode

WORKDIR /home/rustcode

# Copy pre-built Linux binaries from dist directory.
# dist/ may hold both linux-x64 and linux-arm64 artifacts (see scripts/release.sh);
# buildx injects TARGETARCH automatically, so the right binary is selected per platform.
COPY dist/v*/rustcode-daemon-*-linux-* /tmp/

# Install the binary matching the build platform (amd64 -> linux-x64, arm64 -> linux-arm64)
ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then \
        mv /tmp/rustcode-daemon-*-linux-arm64 /usr/local/bin/rustcode-daemon; \
    else \
        mv /tmp/rustcode-daemon-*-linux-x64 /usr/local/bin/rustcode-daemon; \
    fi && \
    chmod +x /usr/local/bin/rustcode-daemon && \
    rm -f /tmp/rustcode-daemon-*-linux-*

# Expose daemon port
EXPOSE 13456

WORKDIR /workspace

# Start daemon only
ENTRYPOINT ["rustcode-daemon"]
